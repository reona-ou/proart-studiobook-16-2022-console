<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AsusFanStudio.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ProArt Studiobook 16（H7600ZM）性能控制台">

    <Grid>
        <ScrollViewer Padding="0,10,0,0" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1180" HorizontalAlignment="Center" Margin="20,2,20,20" Spacing="14">

                <TextBlock Text="ProArt Studiobook 16（H7600ZM）性能控制台"
                           Style="{ThemeResource TitleTextBlockStyle}" Margin="2,0,0,0" />

                <!-- 读数 + 一键切档 -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="18" Padding="18,14">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="34">
                            <StackPanel Width="120">
                                <TextBlock Text="CPU 温度" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="CpuText" Text="--" FontSize="26" />
                            </StackPanel>
                            <StackPanel Width="120">
                                <TextBlock Text="GPU 温度" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="GpuText" Text="--" FontSize="26" />
                            </StackPanel>
                            <StackPanel Width="215">
                                <TextBlock Text="风扇转速（CPU / GPU）" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="FanText" Text="--" FontSize="26" />
                            </StackPanel>
                            <StackPanel Width="110">
                                <TextBlock Text="当前档位" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Border x:Name="ModeChip" CornerRadius="22" Padding="16,4" Margin="0,2,0,0" HorizontalAlignment="Left" Background="#849C8A">
                                    <TextBlock x:Name="ModeText" Text="--" FontSize="20" FontWeight="SemiBold" Foreground="White" />
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="一键切档" VerticalAlignment="Center" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Ctrl+Alt+1 / 2 / 3" VerticalAlignment="Center" Margin="0,3,10,0"
                                       Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button x:Name="GearQuiet" Content="安静" Width="86" Click="Manual_Quiet" />
                            <Button x:Name="GearBalanced" Content="高效" Width="86" Click="Manual_Balanced" />
                            <Button x:Name="GearTurbo" Content="全速" Width="86" Click="Manual_Turbo" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="18" Padding="18,14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="CPU 切换温度区间" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <Canvas x:Name="BandCpu" Height="150" Background="Transparent" />
                        <TextBlock x:Name="LegendCpu" TextWrapping="Wrap" Style="{ThemeResource BodyTextBlockStyle}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="18" Padding="18,14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="GPU 切换温度区间" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="独显达到下方阈值后才参与判断，否则只按 CPU 那条走"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Canvas x:Name="BandGpu" Height="150" Background="Transparent" />
                        <TextBlock x:Name="LegendGpu" TextWrapping="Wrap" Style="{ThemeResource BodyTextBlockStyle}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="18" Padding="18,14">
                    <StackPanel Spacing="10">
                        <TextBlock Text="策略" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <!-- 三列网格，两行的开关按列对齐；原先横向 StackPanel 各列宽度不等，第二行会错位 -->
                        <Grid ColumnSpacing="24" RowSpacing="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ToggleSwitch Grid.Row="0" Grid.Column="0" x:Name="AutoSwitch" Header="启用自动切档" Toggled="AutoSwitch_Toggled" />
                            <ToggleSwitch Grid.Row="0" Grid.Column="1" x:Name="TurboSwitch" Header="允许自动进入全速档" Toggled="TurboSwitch_Toggled" />
                            <ToggleSwitch Grid.Row="0" Grid.Column="2" x:Name="GpuSwitch" Header="启用 GPU 独立判断" Toggled="GpuSwitch_Toggled" />
                            <ToggleSwitch Grid.Row="1" Grid.Column="0" x:Name="AcSwitch" Header="仅接电源时才允许升档" Toggled="AcSwitch_Toggled" />
                            <ToggleSwitch Grid.Row="1" Grid.Column="1" x:Name="BootSwitch" Header="开机自动运行" Toggled="BootSwitch_Toggled" />
                        </Grid>

                        <TextBlock Text="数值设定（改动后点保存才写入配置）" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,4,0,0" />
                        <StackPanel Orientation="Horizontal" Spacing="18">
                            <NumberBox x:Name="GpuEngageBox" Header="GPU 纳入阈值 °C" Width="180"
                                       Minimum="30" Maximum="95" SmallChange="1" SpinButtonPlacementMode="Compact"
                                       ValueChanged="GpuEngageBox_ValueChanged" />
                            <NumberBox x:Name="ConfirmUpBox" Header="升档确认 秒" Width="180"
                                       Minimum="0" Maximum="300" SmallChange="1" SpinButtonPlacementMode="Compact"
                                       ValueChanged="ConfirmUpBox_ValueChanged" />
                            <NumberBox x:Name="ConfirmDownBox" Header="降档确认 秒" Width="180"
                                       Minimum="0" Maximum="600" SmallChange="5" SpinButtonPlacementMode="Compact"
                                       ValueChanged="ConfirmDownBox_ValueChanged" />
                            <NumberBox x:Name="DwellBox" Header="最小停留 秒" Width="180"
                                       Minimum="0" Maximum="600" SmallChange="5" SpinButtonPlacementMode="Compact"
                                       ValueChanged="DwellBox_ValueChanged" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="SaveBtn" Content="保存设定" Click="Save_Click" Style="{StaticResource AccentButtonStyle}" Width="120" />
                            <Button Content="还原默认" Click="ResetDefaults" Width="120" />
                            <Button Content="放弃未保存改动" Click="Discard_Click" Width="150" Margin="10,0,0,0" />
                            <Button Content="退出程序" Click="ExitApp" Width="110" Margin="10,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="18" Padding="18,14">
                    <StackPanel Spacing="10">
                        <TextBlock Text="临时全速（快速降温，到时自动回落）" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <NumberBox x:Name="TimedBox" Header="时长 秒" Width="180" Margin="0,0,10,0"
                                       Minimum="10" Maximum="3600" SmallChange="30" SpinButtonPlacementMode="Compact"
                                       ValueChanged="TimedBox_ValueChanged" />
                            <Button Content="60s" Click="Quick_60" VerticalAlignment="Bottom" />
                            <Button Content="2min" Click="Quick_120" VerticalAlignment="Bottom" />
                            <Button Content="5min" Click="Quick_300" VerticalAlignment="Bottom" />
                            <Button Content="开始临时全速" Click="StartTimed" Margin="12,0,0,0" VerticalAlignment="Bottom" />
                            <Button Content="取消" Click="CancelTimed" VerticalAlignment="Bottom" />
                        </StackPanel>
                        <TextBlock x:Name="CountdownText" Text="未启用" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="StatusText" Text="初始化…" TextWrapping="Wrap" />
                <TextBlock x:Name="BatteryText" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
